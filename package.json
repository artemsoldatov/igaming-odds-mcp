{
  "name": "igaming-odds-mcp",
  "version": "0.1.0",
  "description": "MCP server with betting-odds tools: conversions, bookmaker margin, parlay, settlement, Kelly staking",
  "author": "Artem Soldatov",
  "license": "MIT",
  "type": "module",
  "bin": {
    "igaming-odds-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "pnpm": {
    "overrides": {
      "zod-to-json-schema": "3.24.5"
    }
  }
}
